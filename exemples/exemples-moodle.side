    {
      "id": "e86c44ed-2bdd-468d-bd57-0c2abb857bca",
      "name": "01 - Variables : les bases",
      "commands": [
        {
          "id": "743360eb-3a24-45f2-b507-fb24677f47f0",
          "comment": "",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "34a43b0b-15ba-4424-9430-251fc1f2d036",
          "comment": "crée la variable « salutation »",
          "command": "store",
          "target": "Bonjour",
          "targets": [],
          "value": "salutation"
        },
        {
          "id": "72bd2007-bea3-43a9-9b14-73ae0c2eb2d1",
          "comment": "",
          "command": "echo",
          "target": "${salutation} tout le monde",
          "targets": [],
          "value": ""
        },
        {
          "id": "d22e2111-7a34-4b56-932c-0d044c0e3063",
          "comment": "lit le titre de la page",
          "command": "storeTitle",
          "target": "",
          "targets": [],
          "value": "titre"
        },
        {
          "id": "8e3d480f-cce5-4ea7-abc7-542d10ec46ee",
          "comment": "",
          "command": "echo",
          "target": "Le titre de la page est : ${titre}",
          "targets": [],
          "value": ""
        },
        {
          "id": "59cc01d6-33b5-4db6-86d0-02c95587d9e9",
          "comment": "",
          "command": "storeLocation",
          "target": "",
          "targets": [],
          "value": "adresse"
        },
        {
          "id": "1900a575-5546-4eb6-8e05-68632ea0b1eb",
          "comment": "",
          "command": "echo",
          "target": "Nous sommes sur ${adresse}",
          "targets": [],
          "value": ""
        },
        {
          "id": "10be61e5-1ee8-4d3e-a542-5ce97885c73a",
          "comment": "",
          "command": "store",
          "target": "3",
          "targets": [],
          "value": "nombre"
        },
        {
          "id": "c219d82e-239c-4bc4-a8fd-e3613d321761",
          "comment": "arrête le test si nombre ne vaut pas 3",
          "command": "assert",
          "target": "nombre",
          "targets": [],
          "value": "3"
        }
      ]
    },
    {
      "id": "412e6469-931b-49fa-a894-09b61d814f2c",
      "name": "02 - Connexion",
      "commands": [
        {
          "id": "20bf051f-d72c-4b88-b4d8-1ea2f23075aa",
          "comment": "à remplacer",
          "command": "store",
          "target": "admin",
          "targets": [],
          "value": "identifiant"
        },
        {
          "id": "9bd739fa-f966-47b1-be29-ff54fb3dc396",
          "comment": "à remplacer",
          "command": "store",
          "target": "MotDePasse!1",
          "targets": [],
