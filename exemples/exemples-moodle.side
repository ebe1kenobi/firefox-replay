        },
        {
          "id": "945cf56f-f949-4a78-9e29-67413caf7c46",
          "comment": "",
          "command": "open",
          "target": "/login/index.php",
          "targets": [],
          "value": ""
        },
        {
          "id": "812f8678-ebf1-4396-a321-ce2348e21051",
          "comment": "1 si le formulaire est affiché, 0 si déjà connecté",
          "command": "storeElementCount",
