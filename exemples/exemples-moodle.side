        },
        {
          "id": "02b9043b-3b85-473d-93c3-decb7731bb51",
          "comment": "",
          "command": "echo",
          "target": "Identifiant tiré : ${id}",
          "targets": [],
          "value": ""
        },
        {
          "id": "1e5cdbdc-b553-475f-9f37-b32609241b6d",
          "comment": "",
          "command": "end",
          "target": "",
          "targets": [],
          "value": ""
        },
        {
          "id": "4d94af15-be2d-448b-8302-870211365831",
          "comment": "",
          "command": "store",
          "target": "0",
          "targets": [],
