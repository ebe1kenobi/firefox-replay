        },
        {
          "id": "a00a5d30-c910-4568-b29b-864eaa632147",
          "comment": "",
          "command": "while",
          "target": "${compteur} < 3",
          "targets": [],
          "value": ""
        },
        {
          "id": "275b6ac6-1cee-4937-8107-d53d7f09e69e",
          "comment": "",
          "command": "executeScript",
          "target": "vars.compteur = Number(${compteur}) + 1;",
          "targets": [],
          "value": ""
        },
        {
          "id": "5d0f57d1-1d05-438c-b101-8fc49f9dd101",
          "comment": "",
          "command": "echo",
          "target": "Tour numéro ${compteur}",
          "targets": [],
          "value": ""
        },
        {
          "id": "6fbaa138-f617-437c-acbb-565c7a9a6bea",
          "comment": "",
          "command": "end",
          "target": "",
          "targets": [],
          "value": ""
        }
      ]
