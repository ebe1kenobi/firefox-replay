    {
      "id": "e160a2aa-1cfd-46e3-8be8-803cb2c30e92",
      "name": "04 - JavaScript et variables",
      "commands": [
        {
          "id": "19e1faef-84d2-4eaa-ba3a-ca5d98514c93",
          "comment": "",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "3430ae87-edb5-43c1-8c49-3f08b1eaa2de",
          "comment": "le résultat du return va dans « racine »",
          "command": "executeScript",
          "target": "return M.cfg.wwwroot;",
          "targets": [],
          "value": "racine"
        },
        {
          "id": "f50f3f86-6e2a-4473-a2df-359ba76e754c",
          "comment": "",
          "command": "echo",
          "target": "Adresse du Moodle : ${racine}",
          "targets": [],
          "value": ""
        },
        {
          "id": "f8ce92cb-b89e-42b1-a125-1a1a7e238003",
          "comment": "",
          "command": "executeScript",
          "target": "return document.querySelectorAll('a').length;",
          "targets": [],
          "value": "nbLiens"
        },
        {
          "id": "a25fb7a9-e029-4fe8-ba03-34b2ebec7345",
          "comment": "",
          "command": "if",
          "target": "${nbLiens} > 10",
          "targets": [],
          "value": ""
        },
        {
          "id": "b1d3ef9d-afe4-485e-98b1-4e699d7bdfe1",
          "comment": "",
          "command": "echo",
          "target": "Page riche : ${nbLiens} liens",
          "targets": [],
          "value": ""
        },
        {
          "id": "4499aa97-3fa3-485e-9151-f18864ad318c",
          "comment": "",
          "command": "end",
          "target": "",
          "targets": [],
          "value": ""
        },
        {
          "id": "abe175c1-d3f2-4047-9463-dcd5e712b471",
          "comment": "",
          "command": "store",
          "target": "5",
          "targets": [],
          "value": "a"
        },
        {
          "id": "cef9b71e-1b1c-4d1a-9de3-24fdc1d41b7b",
          "comment": "crée b et message",
          "command": "executeScript",
          "target": "vars.b = Number(${a}) * 2;\nvars.message = 'le double de ' + ${a} + ' est ' + vars.b;",
          "targets": [],
          "value": ""
        },
        {
          "id": "c0ba108a-9e12-4ba0-9656-ce5572f197ff",
          "comment": "",
          "command": "echo",
          "target": "${message}",
          "targets": [],
          "value": ""
        },
        {
          "id": "24fc8970-2fd0-4c62-8810-aaeb2c4c2c19",
          "comment": "",
          "command": "assert",
          "target": "b",
          "targets": [],
          "value": "10"
        }
      ]
    },
    {
      "id": "d8e6329f-744d-41e0-8971-c25f0da59f5f",
      "name": "05 - Boucles",
      "commands": [
        {
