        },
        {
          "id": "4e324bb3-e7da-4990-8dd0-0f98bab1932a",
          "comment": "",
          "command": "echo",
          "target": "Bonjour ${prenom}",
          "targets": [],
          "value": ""
        },
        {
          "id": "4fc5860f-d8b7-4046-8b93-fd24c7f9f732",
          "comment": "",
          "command": "end",
          "target": "",
          "targets": [],
          "value": ""
        },
        {
          "id": "6ce8f700-2abe-4dbd-840a-734d341b0fc4",
          "comment": "",
          "command": "times",
          "target": "3",
