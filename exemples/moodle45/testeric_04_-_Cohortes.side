  "name": "testeric 04 - Cohortes",
  "url": "https://moodle.exemple.fr",
  "tests": [
    {
      "id": "94a1f592-d1f6-42a9-b9d5-bbe3edb31dfc",
      "name": "Créer deux cohortes par l'interface",
      "commands": [
        {
          "id": "59718f35-c9dd-4ce7-aa3f-25ffad9c18c7",
          "comment": "",
          "command": "storeJson",
          "target": "[1, 2]",
          "targets": [],
          "value": "numeros"
        },
        {
          "id": "c9ba269e-7a92-4d80-987a-beb204618b05",
          "comment": "",
          "command": "forEach",
          "target": "numeros",
          "targets": [],
          "value": "n"
        },
        {
          "id": "4979d2f6-7f6c-4151-8865-97050952dac1",
          "comment": "",
          "command": "open",
          "target": "/cohort/edit.php?contextid=1",
          "targets": [],
          "value": ""
        },
        {
          "id": "99afb4f1-be62-4e94-8803-98bcd6b13a2e",
          "comment": "",
          "command": "type",
          "target": "id=id_name",
          "targets": [],
          "value": "testeric_createcohorte_${id}_${n}"
        },
        {
          "id": "5b54e864-b9ec-41c6-a44b-8bb1d1092980",
          "comment": "",
          "command": "type",
          "target": "id=id_idnumber",
          "targets": [],
          "value": "testeric_createcohorte_${id}_${n}"
        },
        {
          "id": "053f5981-b52d-4c50-b519-27607ed9c04b",
          "comment": "remplit l'éditeur id_description_editor",
          "command": "executeScript",
          "target": "const fid = 'id_description_editor';\nconst html = '<p>Cohorte testeric ' + ${id} + ' n° ' + ${n} + '</p>';\nconst ta = document.getElementById(fid);\nif (!ta) throw new Error('Éditeur introuvable : ' + fid);\nfor (let i = 0; i < 50; i++) {\n  let tiny = null;\n  try {\n    const mod = await new Promise((ok, ko) => require(['editor_tiny/editor'], ok, ko));\n    tiny = mod.getInstanceForElementId(fid);\n  } catch (e) { /* TinyMCE absent */ }\n  if (tiny) { tiny.setContent(html); tiny.save(); return 'TinyMCE'; }\n  const atto = document.getElementById(fid + 'editable');\n  if (atto) { atto.innerHTML = html; ta.value = html; return 'Atto'; }\n  await new Promise(r => setTimeout(r, 100));\n}\nta.value = html;\nreturn 'zone de texte';",
          "targets": [],
          "value": ""
        },
        {
          "id": "900c7f88-277b-404e-bed1-592639195e05",
          "comment": "",
          "command": "click",
          "target": "id=id_submitbutton",
          "targets": [],
          "value": ""
        },
        {
          "id": "7f5e34da-db98-4b68-8ce6-8cb1c60fad1f",
          "comment": "vérifie que Moodle a accepté le formulaire",
          "command": "executeScript",
          "target": "if (location.pathname.endsWith('/cohort/edit.php')) {\n  const errs = [...document.querySelectorAll('.invalid-feedback, .alert-danger, .error')]\n    .map(e => e.textContent.trim()).filter(Boolean);\n  throw new Error('Formulaire refusé' + (errs.length ? ' : ' + errs.join(' / ') : ''));\n}\nreturn true;",
          "targets": [],
          "value": ""
        },
        {
          "id": "24fe913c-2d31-41d0-9021-66309ad8b113",
          "comment": "",
          "command": "end",
          "target": "",
          "targets": [],
          "value": ""
        },
        {
          "id": "69ab5be5-e36c-4350-bb61-aca3d2fc4c06",
          "comment": "",
          "command": "executeScript",
          "target": "const ajax = await new Promise((ok, ko) => require(['core/ajax'], ok, ko));\nconst call = (methodname, args) => ajax.call([{ methodname, args }])[0];\nconst res = await call('core_cohort_search_cohorts', {\n  query: 'testeric_createcohorte', context: { contextid: 1 }, includes: 'all', limitfrom: 0, limitnum: 100 });\nconst find = name => {\n  const c = res.cohorts.find(x => x.name === name);\n  if (!c) throw new Error('Cohorte introuvable : ' + name);\n  return c.id;\n};\nvars.cohortIhm1 = find('testeric_createcohorte_' + ${id} + '_1');\nvars.cohortIhm2 = find('testeric_createcohorte_' + ${id} + '_2');\nreturn [vars.cohortIhm1, vars.cohortIhm2].join(', ');",
          "targets": [],
          "value": "cohortesIhm"
        },
        {
          "id": "19505235-7514-42b1-8372-15b6ddb6b151",
          "comment": "",
          "command": "open",
          "target": "/cohort/index.php?contextid=1",
          "targets": [],
          "value": ""
        },
        {
          "id": "ff93b84e-cd29-48c6-a194-e2e95095d30d",
          "comment": "",
          "command": "screenshot",
          "target": "cohortes interface",
          "targets": [],
          "value": ""
        }
      ]
    },
