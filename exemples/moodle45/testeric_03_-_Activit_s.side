    {
      "id": "db29b85e-c6b9-46fd-a32c-60779674b0fd",
      "name": "Devoir (assign)",
      "commands": [
        {
          "id": "f95210a8-e95a-4737-b3f0-a874312f2dc9",
          "comment": "",
          "command": "open",
          "target": "/course/modedit.php?add=assign&type=&course=${courseid}&section=1",
          "targets": [],
          "value": ""
        },
        {
          "id": "05a2f9bb-5dd7-4763-934f-799bc367c9ad",
          "comment": "",
          "command": "type",
          "target": "id=id_name",
          "targets": [],
          "value": "testeric_createassign_${id}_1"
        },
        {
          "id": "442c41c8-8a8f-476e-bc0f-2dc8cc1c641a",
          "comment": "remplit l'éditeur id_introeditor",
          "command": "executeScript",
          "target": "const fid = 'id_introeditor';\nconst html = '<p>Description de ' + 'testeric_createassign_' + ${id} + '_1' + '</p>';\nconst ta = document.getElementById(fid);\nif (!ta) throw new Error('Éditeur introuvable : ' + fid);\nfor (let i = 0; i < 50; i++) {\n  let tiny = null;\n  try {\n    const mod = await new Promise((ok, ko) => require(['editor_tiny/editor'], ok, ko));\n    tiny = mod.getInstanceForElementId(fid);\n  } catch (e) { /* TinyMCE absent */ }\n  if (tiny) { tiny.setContent(html); tiny.save(); return 'TinyMCE'; }\n  const atto = document.getElementById(fid + 'editable');\n  if (atto) { atto.innerHTML = html; ta.value = html; return 'Atto'; }\n  await new Promise(r => setTimeout(r, 100));\n}\nta.value = html;\nreturn 'zone de texte';",
          "targets": [],
          "value": ""
        },
        {
          "id": "8a933d92-6291-4e5a-a753-9bd94ee005fb",
          "comment": "« Enregistrer et revenir au cours »",
          "command": "click",
          "target": "id=id_submitbutton2",
          "targets": [],
          "value": ""
        },
        {
          "id": "14973574-ccc1-44f7-bea4-264a1107b7e3",
          "comment": "vérifie que Moodle a accepté le formulaire",
          "command": "executeScript",
          "target": "if (location.pathname.endsWith('/course/modedit.php')) {\n  const errs = [...document.querySelectorAll('.invalid-feedback, .alert-danger, .error')]\n    .map(e => e.textContent.trim()).filter(Boolean);\n  throw new Error('Formulaire refusé' + (errs.length ? ' : ' + errs.join(' / ') : ''));\n}\nreturn true;",
          "targets": [],
          "value": ""
        },
        {
          "id": "ce494f25-4993-4997-bb12-26589d08b2ad",
          "comment": "",
          "command": "waitForTextPresent",
          "target": "testeric_createassign_${id}_1",
          "targets": [],
          "value": ""
        },
        {
          "id": "f2570bd6-7247-452a-9f82-fba6d4e18704",
          "comment": "",
          "command": "screenshot",
          "target": "assign",
          "targets": [],
          "value": ""
        }
      ]
