          "target": "/enrol/instances.php?id=${courseid}",
          "targets": [],
          "value": ""
        },
        {
          "id": "79d24455-4dfa-416e-9715-0315222b125b",
          "comment": "icône « Désactiver » de la méthode",
          "command": "click",
          "target": "xpath=//tr[contains(normalize-space(.), 'testeric_createcohortecsv_${id}_2')]//a[contains(@href,'action=disable')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "333139c9-5b9f-49dd-8826-e7e3f6d09ece",
          "comment": "la méthode est désactivée",
          "command": "waitForElementPresent",
          "target": "xpath=//tr[contains(normalize-space(.), 'testeric_createcohortecsv_${id}_2')]//a[contains(@href,'action=enable')]",
