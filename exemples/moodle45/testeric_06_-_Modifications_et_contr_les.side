        {
          "id": "62fe4d85-878b-45e0-b7de-565521cdc4b7",
          "comment": "contrôle par le service web",
          "command": "executeScript",
          "target": "const ajax = await new Promise((ok, ko) => require(['core/ajax'], ok, ko));\nconst call = (methodname, args) => ajax.call([{ methodname, args }])[0];\nconst [u] = await call('core_user_get_users_by_field', { field: 'id', values: [String(${uidIhm2})] });\nif (!!u.suspended !== true) throw new Error('Suspendu : ' + u.suspended + ', attendu true');\nreturn u.suspended;",
