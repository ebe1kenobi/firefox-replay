    {
      "id": "89d385d6-7179-43fc-8ec8-e6d7197622ae",
      "name": "Masquer puis réafficher une cohorte",
      "commands": [
        {
          "id": "625c4e9a-7550-43c7-a4d9-c7fb1554cfc2",
          "comment": "",
          "command": "open",
          "target": "/cohort/edit.php?id=${cohortCsv1}",
          "targets": [],
          "value": ""
        },
        {
          "id": "e6f56e5e-4346-49b9-9356-f6dfe5f8d968",
          "comment": "",
          "command": "uncheck",
          "target": "id=id_visible",
          "targets": [],
          "value": ""
        },
        {
          "id": "58921a4d-a6bb-40db-8ba9-750aa0e77755",
          "comment": "",
          "command": "click",
          "target": "id=id_submitbutton",
          "targets": [],
          "value": ""
        },
        {
          "id": "b9872751-cd7d-4668-ba80-4dbc32be912f",
          "comment": "vérifie que Moodle a accepté le formulaire",
          "command": "executeScript",
          "target": "if (location.pathname.endsWith('/cohort/edit.php')) {\n  const errs = [...document.querySelectorAll('.invalid-feedback, .alert-danger, .error')]\n    .map(e => e.textContent.trim()).filter(Boolean);\n  throw new Error('Formulaire refusé' + (errs.length ? ' : ' + errs.join(' / ') : ''));\n}\nreturn true;",
          "targets": [],
          "value": ""
        },
        {
          "id": "71fb5a6a-bb69-49c2-bbd9-b77f440cdfb7",
          "comment": "contrôle de la visibilité par le service web",
          "command": "executeScript",
          "target": "const ajax = await new Promise((ok, ko) => require(['core/ajax'], ok, ko));\nconst call = (methodname, args) => ajax.call([{ methodname, args }])[0];\nconst res = await call('core_cohort_search_cohorts', {\n  query: 'testeric_createcohortecsv_' + ${id} + '_1', context: { contextid: 1 }, includes: 'all', limitfrom: 0, limitnum: 10 });\nconst c = res.cohorts.find(x => Number(x.id) === Number(${cohortCsv1}));\nif (!c) throw new Error('Cohorte introuvable');\nif (!!c.visible !== false) throw new Error('Visibilité de la cohorte : ' + c.visible + ', attendu false');\nreturn c.visible;",
          "targets": [],
          "value": ""
        },
        {
          "id": "0d905427-0b11-491d-ac10-0eb8ae63ca6e",
          "comment": "",
          "command": "screenshot",
          "target": "cohorte masquee",
          "targets": [],
          "value": ""
        },
        {
          "id": "b5d6cd21-f1d5-4b23-b9bf-affae894cf5b",
          "comment": "",
          "command": "open",
          "target": "/cohort/edit.php?id=${cohortCsv1}",
          "targets": [],
          "value": ""
        },
        {
          "id": "f5f9d5f6-7bfb-463d-b6ff-94600b8a0c5b",
          "comment": "",
          "command": "check",
          "target": "id=id_visible",
          "targets": [],
          "value": ""
        },
        {
          "id": "a73e8ac7-7079-479b-aae5-df788093fc26",
          "comment": "",
          "command": "click",
          "target": "id=id_submitbutton",
          "targets": [],
          "value": ""
        },
        {
          "id": "00068a02-e5e5-4ed2-a507-7cb82d2ffd6a",
          "comment": "vérifie que Moodle a accepté le formulaire",
          "command": "executeScript",
          "target": "if (location.pathname.endsWith('/cohort/edit.php')) {\n  const errs = [...document.querySelectorAll('.invalid-feedback, .alert-danger, .error')]\n    .map(e => e.textContent.trim()).filter(Boolean);\n  throw new Error('Formulaire refusé' + (errs.length ? ' : ' + errs.join(' / ') : ''));\n}\nreturn true;",
          "targets": [],
          "value": ""
        },
        {
          "id": "1253693b-55ce-4f2c-b9a5-1cc3c2ad1fd2",
          "comment": "contrôle de la visibilité par le service web",
          "command": "executeScript",
          "target": "const ajax = await new Promise((ok, ko) => require(['core/ajax'], ok, ko));\nconst call = (methodname, args) => ajax.call([{ methodname, args }])[0];\nconst res = await call('core_cohort_search_cohorts', {\n  query: 'testeric_createcohortecsv_' + ${id} + '_1', context: { contextid: 1 }, includes: 'all', limitfrom: 0, limitnum: 10 });\nconst c = res.cohorts.find(x => Number(x.id) === Number(${cohortCsv1}));\nif (!c) throw new Error('Cohorte introuvable');\nif (!!c.visible !== true) throw new Error('Visibilité de la cohorte : ' + c.visible + ', attendu true');\nreturn c.visible;",
          "targets": [],
          "value": ""
        }
      ]
    },
