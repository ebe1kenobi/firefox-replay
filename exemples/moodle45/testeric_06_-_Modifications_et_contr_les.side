          "command": "executeScript",
          "target": "const ajax = await new Promise((ok, ko) => require(['core/ajax'], ok, ko));\nconst call = (methodname, args) => ajax.call([{ methodname, args }])[0];\nconst [u] = await call('core_user_get_users_by_field', { field: 'id', values: [String(${uidIhm2})] });\nif (!!u.suspended !== false) throw new Error('Suspendu : ' + u.suspended + ', attendu false');\nreturn u.suspended;",
