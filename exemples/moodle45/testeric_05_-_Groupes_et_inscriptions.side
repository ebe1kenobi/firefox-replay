        {
          "id": "ead1c39f-ec39-497a-9ccc-e551f69e384d",
          "comment": "contrôle par core_enrol_search_users",
          "command": "executeScript",
          "target": "const ajax = await new Promise((ok, ko) => require(['core/ajax'], ok, ko));\nconst call = (methodname, args) => ajax.call([{ methodname, args }])[0];\nconst users = await call('core_enrol_search_users', {\n  courseid: Number(${courseid}), search: 'testeric', searchanywhere: true, page: 0, perpage: 100 });\nconst ids = users.map(u => u.id);\nconst manquants = [${uidIhm1}, ${uidIhm2}, ${uidCsv1}, ${uidCsv2}].filter(id => !ids.includes(Number(id)));\nif (manquants.length) throw new Error('Utilisateurs non inscrits : ' + manquants.join(', '));\nreturn users.length;",
          "targets": [],
          "value": "inscrits"
        },
        {
          "id": "624ff0c1-ca89-49e7-97e0-dfe9d98b8971",
          "comment": "",
